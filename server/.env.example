# PayBastion AI - Server Environment Variables

PORT=5000

# PayPal Developer Sandbox Credentials
# Get your Sandbox App credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Cryptographic Master Secret for Offline Passport Signature Verification (HMAC-SHA256)
OFFLINE_PASSPORT_SECRET=paybastion_master_auth_secret_k9x2m4p8z1

# Optional: Google Gemini API Key for dynamic natural language explanations
# If not provided, PayBastion uses its built-in deterministic heuristic rule engine
GEMINI_API_KEY=
